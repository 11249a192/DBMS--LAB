
-- EXPERIMENT 1: SQL COMMANDS

-- 1. CREATE DATABASE
CREATE DATABASE CollegeDB;

-- 2. USE DATABASE
USE CollegeDB;

-- 3. CREATE TABLE
CREATE TABLE Student (
    StudentID INT PRIMARY KEY,
    StudentName VARCHAR(30),
    Department VARCHAR(20),
    Age INT,
    CGPA DECIMAL(3,2)
);

-- 4. INSERT RECORDS
INSERT INTO Student VALUES
(101, 'Anu', 'CSE', 20, 8.90),
(102, 'Bala', 'ECE', 21, 8.50),
(103, 'Charles', 'IT', 20, 9.10),
(104, 'Divya', 'CSE', 22, 8.70),
(105, 'Esha', 'AIDS', 21, 9.20);

-- 5. DISPLAY ALL STUDENT RECORDS
SELECT * FROM Student;

-- RESULT:
-- +-----------+-------------+------------+-----+------+
-- | StudentID | StudentName | Department | Age | CGPA |
-- +-----------+-------------+------------+-----+------+
-- | 101       | Anu         | CSE        | 20  | 8.90 |
-- | 102       | Bala        | ECE        | 21  | 8.50 |
-- | 103       | Charles     | IT         | 20  | 9.10 |
-- | 104       | Divya       | CSE        | 22  | 8.70 |
-- | 105       | Esha        | AIDS       | 21  | 9.20 |
-- +-----------+-------------+------------+-----+------+

-- 6. DISPLAY STUDENTS FROM CSE DEPARTMENT
SELECT * FROM Student
WHERE Department = 'CSE';

-- RESULT:
-- 101 | Anu   | CSE | 20 | 8.90
-- 104 | Divya | CSE | 22 | 8.70

-- 7. DISPLAY STUDENTS WITH CGPA ABOVE 8.8
SELECT * FROM Student
WHERE CGPA > 8.8;

-- RESULT:
-- 101 | Anu     | CSE  | 20 | 8.90
-- 103 | Charles | IT   | 20 | 9.10
-- 105 | Esha    | AIDS | 21 | 9.20

-- 8. SORT STUDENTS BY CGPA IN DESCENDING ORDER
SELECT * FROM Student
ORDER BY CGPA DESC;

-- RESULT:
-- 105 | Esha    | AIDS | 21 | 9.20
-- 103 | Charles | IT   | 20 | 9.10
-- 101 | Anu     | CSE  | 20 | 8.90
-- 104 | Divya   | CSE  | 22 | 8.70
-- 102 | Bala    | ECE  | 21 | 8.50

-- 9. COUNT TOTAL NUMBER OF STUDENTS
SELECT COUNT(*) AS TotalStudents
FROM Student;

-- RESULT:
-- TotalStudents
-- 5

-- 10. FIND AVERAGE CGPA
SELECT AVG(CGPA) AS AverageCGPA
FROM Student;

-- RESULT:
-- AverageCGPA
-- 8.88

-- 11. FIND HIGHEST CGPA
SELECT MAX(CGPA) AS HighestCGPA
FROM Student;

-- RESULT:
-- HighestCGPA
-- 9.20

-- 12. FIND LOWEST CGPA
SELECT MIN(CGPA) AS LowestCGPA
FROM Student;

-- RESULT:
-- LowestCGPA
-- 8.50

-- 13. DISPLAY STUDENT NAMES IN ASCENDING ORDER
SELECT StudentName FROM Student
ORDER BY StudentName ASC;

-- RESULT:
-- Anu
-- Bala
-- Charles
-- Divya
-- Esha

-- 14. DISPLAY STUDENTS WHOSE AGE IS 20
SELECT * FROM Student
WHERE Age = 20;

-- RESULT:
-- 101 | Anu     | CSE | 20 | 8.90
-- 103 | Charles | IT  | 20 | 9.10

-- 15. DISPLAY DISTINCT DEPARTMENTS
SELECT DISTINCT Department FROM Student;

-- RESULT:
-- CSE
-- ECE
-- IT
-- AIDS

-- FINAL RESULT:
-- Thus, the SQL commands were executed successfully.

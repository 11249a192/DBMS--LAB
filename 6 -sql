
-- ============================================================
-- EXPERIMENT 6
-- QUERIES USING AGGREGATE FUNCTIONS, GROUP BY AND HAVING
-- ============================================================

-- 1. CREATE DATABASE

CREATE DATABASE IF NOT EXISTS EmployeeDB;
USE EmployeeDB;

-- 2. CREATE EMPLOYEE TABLE

DROP TABLE IF EXISTS Employee;

CREATE TABLE Employee (
    EmpID INT PRIMARY KEY,
    EmpName VARCHAR(50),
    Department VARCHAR(30),
    Designation VARCHAR(30),
    Salary DECIMAL(10,2),
    City VARCHAR(30),
    DOJ DATE
);

-- 3. INSERT SAMPLE RECORDS

INSERT INTO Employee VALUES
(1, 'Aarav Sharma', 'IT', 'Developer', 55000, 'Chennai', '2021-03-15'),
(2, 'Priya Nair', 'IT', 'Team Lead', 75000, 'Chennai', '2019-06-10'),
(3, 'Rohit Verma', 'HR', 'Executive', 35000, 'Bangalore', '2022-01-20'),
(4, 'Sneha Iyer', 'HR', 'Manager', 65000, 'Bangalore', '2018-11-05'),
(5, 'Karthik Raj', 'Finance', 'Analyst', 45000, 'Chennai', '2020-07-01'),
(6, 'Divya Menon', 'Finance', 'Manager', 70000, 'Mumbai', '2017-09-25'),
(7, 'Arjun Das', 'IT', 'Developer', 58000, 'Mumbai', '2021-12-12'),
(8, 'Fatima Khan', 'HR', 'Executive', 36000, 'Chennai', '2023-02-18'),
(9, 'Vikram Singh', 'Finance', 'Analyst', 47000, 'Bangalore', '2022-05-30'),
(10, 'Meera Pillai', 'IT', 'Developer', 59000, 'Bangalore', '2020-08-14');


-- DISPLAY ALL EMPLOYEE RECORDS

SELECT * FROM Employee;

-- RESULT:
-- 1  Aarav Sharma  IT       Developer  55000  Chennai
-- 2  Priya Nair    IT       Team Lead  75000  Chennai
-- 3  Rohit Verma   HR       Executive  35000  Bangalore
-- 4  Sneha Iyer    HR       Manager    65000  Bangalore
-- 5  Karthik Raj   Finance  Analyst    45000  Chennai
-- 6  Divya Menon   Finance  Manager    70000  Mumbai
-- 7  Arjun Das     IT       Developer  58000  Mumbai
-- 8  Fatima Khan   HR       Executive  36000  Chennai
-- 9  Vikram Singh  Finance  Analyst    47000  Bangalore
-- 10 Meera Pillai  IT       Developer  59000  Bangalore


-- 4. COUNT TOTAL NUMBER OF EMPLOYEES

SELECT COUNT(*) AS TotalEmployees
FROM Employee;

-- RESULT:
-- TotalEmployees
-- 10


-- 5. FIND TOTAL SALARY PAID BY THE COMPANY

SELECT SUM(Salary) AS TotalSalary
FROM Employee;

-- RESULT:
-- TotalSalary
-- 545000.00


-- 6. FIND AVERAGE SALARY OF EMPLOYEES

SELECT AVG(Salary) AS AverageSalary
FROM Employee;

-- RESULT:
-- AverageSalary
-- 54500.00


-- 7. FIND HIGHEST AND LOWEST SALARY

SELECT
MAX(Salary) AS HighestSalary,
MIN(Salary) AS LowestSalary
FROM Employee;

-- RESULT:
-- HighestSalary | LowestSalary
-- 75000.00      | 35000.00


-- 8. COUNT EMPLOYEES IN EACH DEPARTMENT

SELECT Department, COUNT(*) AS EmpCount
FROM Employee
GROUP BY Department
ORDER BY Department;

-- RESULT:
-- Department | EmpCount
-- Finance    | 3
-- HR         | 3
-- IT         | 4


-- 9. FIND AVERAGE SALARY DEPARTMENT-WISE

SELECT Department, AVG(Salary) AS AvgSalary
FROM Employee
GROUP BY Department
ORDER BY AvgSalary DESC;

-- RESULT:
-- Department | AvgSalary
-- IT         | 61750.00
-- Finance    | 54000.00
-- HR         | 45333.33


-- 10. DEPARTMENTS HAVING MORE THAN 3 EMPLOYEES

SELECT Department, COUNT(*) AS EmpCount
FROM Employee
GROUP BY Department
HAVING COUNT(*) > 3;

-- RESULT:
-- Department | EmpCount
-- IT         | 4


-- 11. DEPARTMENTS WHERE AVERAGE SALARY EXCEEDS 50000

SELECT Department, AVG(Salary) AS AvgSalary
FROM Employee
GROUP BY Department
HAVING AVG(Salary) > 50000
ORDER BY AvgSalary DESC;

-- RESULT:
-- Department | AvgSalary
-- IT         | 61750.00
-- Finance    | 54000.00


-- 12. COMBINE WHERE, GROUP BY AND HAVING

SELECT Department, City, COUNT(*) AS EmpCount
FROM Employee
WHERE Salary > 40000
GROUP BY Department, City
HAVING COUNT(*) >= 2
ORDER BY Department;

-- RESULT:
-- Department | City     | EmpCount
-- Finance    | (No result)
-- IT         | Bangalore| 2
-- IT         | Chennai  | 2


-- 13. CITY-WISE TOTAL SALARY EXPENDITURE ABOVE 100000

SELECT City, SUM(Salary) AS TotalSalary
FROM Employee
GROUP BY City
HAVING SUM(Salary) > 100000
ORDER BY TotalSalary DESC;

-- RESULT:
-- City      | TotalSalary
-- Chennai   | 211000.00
-- Bangalore | 206000.00
-- Mumbai    | 128000.00


-- 14. NUMBER OF DISTINCT DESIGNATIONS

SELECT COUNT(DISTINCT Designation) AS TotalDesignations
FROM Employee;

-- RESULT:
-- TotalDesignations
-- 5


-- 15. MAXIMUM SALARY IN EACH DEPARTMENT

SELECT Department, MAX(Salary) AS MaximumSalary
FROM Employee
GROUP BY Department;

-- RESULT:
-- Finance | 70000.00
-- HR      | 65000.00
-- IT      | 75000.00


-- 16. DEPARTMENTS WITH AVERAGE SALARY LESS THAN 50000

SELECT Department, AVG(Salary) AS AvgSalary
FROM Employee
GROUP BY Department
HAVING AVG(Salary) < 50000;

-- RESULT:
-- Department | AvgSalary
-- HR         | 45333.33


-- 17. NUMBER OF EMPLOYEES JOINED EACH YEAR

SELECT YEAR(DOJ) AS JoiningYear,
COUNT(*) AS EmployeeCount
FROM Employee
GROUP BY YEAR(DOJ)
ORDER BY JoiningYear;

-- RESULT:
-- JoiningYear | EmployeeCount
-- 2017        | 1
-- 2018        | 1
-- 2019        | 1
-- 2020        | 2
-- 2021        | 2
-- 2022        | 2
-- 2023        | 1


-- 18. DEPARTMENTS WITH EMPLOYEES IN MORE THAN ONE CITY

SELECT Department,
COUNT(*) AS EmployeeCount,
COUNT(DISTINCT City) AS CityCount
FROM Employee
GROUP BY Department
HAVING COUNT(DISTINCT City) > 1;

-- RESULT:
-- Department | EmployeeCount | CityCount
-- Finance    | 3             | 3
-- HR         | 3             | 2
-- IT         | 4             | 3


-- 19. CITY WITH THE HIGHEST TOTAL SALARY EXPENDITURE

SELECT City, SUM(Salary) AS TotalSalary
FROM Employee
GROUP BY City
ORDER BY TotalSalary DESC
LIMIT 1;

-- RESULT:
-- City    | TotalSalary
-- Chennai | 211000.00


-- 20. DESIGNATIONS HAVING MORE THAN 2 EMPLOYEES

SELECT Designation, COUNT(*) AS EmployeeCount
FROM Employee
GROUP BY Designation
HAVING COUNT(*) > 2
ORDER BY EmployeeCount DESC;

-- RESULT:
-- Designation | EmployeeCount
-- Developer   | 3



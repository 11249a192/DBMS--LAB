
-- =====================================================
-- EXPERIMENT 5: SQL OPERATORS AND CONSTRAINTS
-- =====================================================

-- 1. CREATE DATABASE

CREATE DATABASE IF NOT EXISTS CollegeDB;
USE CollegeDB;


-- 2. DROP EXISTING TABLES

DROP TABLE IF EXISTS Enrollment;
DROP TABLE IF EXISTS Course;
DROP TABLE IF EXISTS Student;
DROP TABLE IF EXISTS Department;


-- 3. CREATE DEPARTMENT TABLE

CREATE TABLE Department (
    dept_id INT PRIMARY KEY,
    dept_name VARCHAR(50) NOT NULL UNIQUE
);


-- 4. CREATE STUDENT TABLE

CREATE TABLE Student (
    roll_no INT PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    age INT CHECK (age >= 17 AND age <= 30),
    email VARCHAR(50) UNIQUE,
    gender VARCHAR(10) DEFAULT 'Not Specified',
    dept_id INT,
    FOREIGN KEY (dept_id) REFERENCES Department(dept_id)
);


-- 5. CREATE COURSE TABLE

CREATE TABLE Course (
    course_id INT PRIMARY KEY,
    course_name VARCHAR(50) NOT NULL,
    credits INT CHECK (credits BETWEEN 1 AND 6),
    dept_id INT,
    FOREIGN KEY (dept_id) REFERENCES Department(dept_id)
);


-- 6. CREATE ENROLLMENT TABLE

CREATE TABLE Enrollment (
    roll_no INT,
    course_id INT,
    marks INT CHECK (marks BETWEEN 0 AND 100),
    PRIMARY KEY (roll_no, course_id),
    FOREIGN KEY (roll_no) REFERENCES Student(roll_no),
    FOREIGN KEY (course_id) REFERENCES Course(course_id)
);



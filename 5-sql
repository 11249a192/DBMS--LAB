-- 12. IN OPERATOR
-- Students belonging to Computer Science or Mechanical

SELECT name, dept_id
FROM Student
WHERE dept_id IN (
    SELECT dept_id
    FROM Department
    WHERE dept_name IN ('Computer Science', 'Mechanical')
);

-- RESULT:
-- Arun  | 1
-- Kumar | 1
-- Sita  | 3


-- 13. NOT IN OPERATOR
-- Students not enrolled in DBMS

SELECT name
FROM Student
WHERE roll_no NOT IN (
    SELECT roll_no
    FROM Enrollment
    WHERE course_id = 4
);

-- RESULT:
-- Sita
-- Meena


-- 14. ANY OPERATOR
-- Students who scored more than ANY mark in course 2

SELECT DISTINCT s.name, e.marks
FROM Student s
JOIN Enrollment e ON s.roll_no = e.roll_no
WHERE e.marks > ANY (
    SELECT marks
    FROM Enrollment
    WHERE course_id = 2
);

-- RESULT:
-- Arun  | 85
-- Arun  | 78
-- Priya | 55
-- Kumar | 90
-- Kumar | 88
-- Sita  | 70


-- 15. ANY OPERATOR
-- Departments offering courses with credits equal to
-- ANY course in department 1

SELECT DISTINCT dept_id
FROM Course
WHERE credits = ANY (
    SELECT credits
    FROM Course
    WHERE dept_id = 1
);

-- RESULT:
-- 1
-- 3


-- 16. ALL OPERATOR
-- Students who scored more than ALL marks in course 2

SELECT DISTINCT s.name, e.marks
FROM Student s
JOIN Enrollment e ON s.roll_no = e.roll_no
WHERE e.marks > ALL (
    SELECT marks
    FROM Enrollment
    WHERE course_id = 2
);

-- RESULT:
-- Arun  | 85
-- Kumar | 90
-- Kumar | 88
-- Sita  | 70


-- 17. ALL OPERATOR
-- Courses having credits greater than or equal to
-- ALL courses in Electronics department

SELECT course_name, credits
FROM Course
WHERE credits >= ALL (
    SELECT credits
    FROM Course
    WHERE dept_id = (
        SELECT dept_id
        FROM Department
        WHERE dept_name = 'Electronics'
    )
);

-- RESULT:
-- Data Structures | 4
-- Thermodynamics  | 4
-- DBMS            | 4


-- 18. EXISTS OPERATOR
-- Departments having at least one student

SELECT dept_name
FROM Department d
WHERE EXISTS (
    SELECT 1
    FROM Student s
    WHERE s.dept_id = d.dept_id
);

-- RESULT:
-- Computer Science
-- Electronics
-- Mechanical


-- 19. NOT EXISTS OPERATOR
-- Students not enrolled in any course

SELECT name
FROM Student s
WHERE NOT EXISTS (
    SELECT 1
    FROM Enrollment e
    WHERE e.roll_no = s.roll_no
);

-- RESULT:
-- Empty Set


-- 20. NOT EXISTS OPERATOR
-- Departments that offer no courses

SELECT dept_name
FROM Department d
WHERE NOT EXISTS (
    SELECT 1
    FROM Course c
    WHERE c.dept_id = d.dept_id
);

-- RESULT:
-- Empty Set


-- 21. UNION OPERATOR
-- Students scoring above 80 in DBMS or Data Structures

SELECT roll_no
FROM Enrollment
WHERE course_id = 4 AND marks > 80

UNION

SELECT roll_no
FROM Enrollment
WHERE course_id = 1 AND marks > 80;

-- RESULT:
-- 101
-- 103


-- 22. UNION ALL OPERATOR

SELECT roll_no
FROM Enrollment
WHERE course_id = 4 AND marks > 80

UNION ALL

SELECT roll_no
FROM Enrollment
WHERE course_id = 1 AND marks > 80;

-- RESULT:
-- 103
-- 101
-- 103


-- 23. INTERSECT OPERATOR
-- Students enrolled in both course 1 and course 4

-- MySQL 8.0.31 or later:

-- SELECT roll_no
-- FROM Enrollment
-- WHERE course_id = 1
-- INTERSECT
-- SELECT roll_no
-- FROM Enrollment
-- WHERE course_id = 4;


-- MySQL-compatible alternative:

SELECT roll_no
FROM Enrollment
WHERE course_id = 1
AND roll_no IN (
    SELECT roll_no
    FROM Enrollment
    WHERE course_id = 4
);

-- RESULT:
-- 101
-- 103


-- 24. EXCEPT / MINUS OPERATOR
-- Students in course 1 but not in course 4

SELECT roll_no
FROM Enrollment
WHERE course_id = 1
AND roll_no NOT IN (
    SELECT roll_no
    FROM Enrollment
    WHERE course_id = 4
);

-- RESULT:
-- Empty Set


